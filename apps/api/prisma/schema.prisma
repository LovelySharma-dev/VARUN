  contribution     Decimal        @db.Decimal
  isDeduction      Boolean        @default(false) @map("is_deduction")
  capApplied       Decimal?       @map("cap_applied") @db.Decimal
  reason           String
  score            CandidateScore @relation(fields: [candidateScoreId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([candidateScoreId, componentName])
  @@map("score_components")
}


model CandidateScore {
  id                 String              @id @default(dbgenerated("gen_random_uuid()")) @map("candidate_score_id") @db.Uuid
  candidateId        String              @map("candidate_id") @db.Uuid
  scoreVersion       String              @map("score_version")
  configHash         String              @map("config_hash")
  investigativeScore Decimal             @map("investigative_score") @db.Decimal
  rank               Int
  confidence         evidence_confidence
  positiveTotal      Decimal             @map("positive_total") @db.Decimal
  negativeTotal      Decimal             @default(0) @map("negative_total") @db.Decimal
  confidenceCap      Decimal?            @map("confidence_cap") @db.Decimal
  explanation        String
  createdAt          DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  candidate          Phase3Candidate     @relation(fields: [candidateId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  components         ScoreComponent[]

  @@unique([candidateId, scoreVersion])
  @@index([scoreVersion, rank], map: "candidate_scores_rank_idx")
  @@map("candidate_scores")
}

model ScoreComponent {
  id               String         @id @default(dbgenerated("gen_random_uuid()")) @map("score_component_id") @db.Uuid
  candidateScoreId String         @map("candidate_score_id") @db.Uuid
  componentName    String         @map("component_name")

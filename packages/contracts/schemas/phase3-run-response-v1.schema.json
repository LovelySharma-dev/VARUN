{
  "$defs": {
    "CandidateTrackRefPublic": {
      "additionalProperties": false,
      "properties": {
        "artifactFile": {
          "const": "candidate_tracks.geojson",
          "title": "Artifactfile",
          "type": "string"
        },
        "candidateId": {
          "minLength": 1,
          "title": "Candidateid",
          "type": "string"
        }
      },
      "required": [
        "artifactFile",
        "candidateId"
      ],
      "title": "CandidateTrackRefPublic",
      "type": "object"
    },
    "ClosestApproachPublic": {
      "additionalProperties": false,
      "properties": {
        "distanceKm": {
          "minimum": 0,
          "title": "Distancekm",
          "type": "number"
        },
        "timestampUtc": {
          "format": "date-time",
          "title": "Timestamputc",
          "type": "string"
        }
      },
      "required": [
        "distanceKm",
        "timestampUtc"
      ],
      "title": "ClosestApproachPublic",
      "type": "object"
    },
    "DataQualityPublic": {
      "additionalProperties": false,
      "description": "Descriptive eligibility metadata; never a score-v1 component.",
      "properties": {
        "status": {
          "const": "MODEL_ELIGIBLE",
          "title": "Status",
          "type": "string"
        },
        "observationCount": {
          "minimum": 1,
          "title": "Observationcount",
          "type": "integer"
        },
        "eligibleWindowCount": {
          "minimum": 1,
          "title": "Eligiblewindowcount",
          "type": "integer"
        },
        "anomalyWindowCount": {
          "minimum": 0,
          "title": "Anomalywindowcount",
          "type": "integer"
        },
        "includedInScoreV1": {
          "const": false,
          "title": "Includedinscorev1",
          "type": "boolean"
        }
      },
      "required": [
        "status",
        "observationCount",
        "eligibleWindowCount",
        "anomalyWindowCount",
        "includedInScoreV1"
      ],
      "title": "DataQualityPublic",
      "type": "object"
    },
    "RankedCandidatePublic": {
      "additionalProperties": false,
      "properties": {
        "rank": {
          "minimum": 1,
          "title": "Rank",
          "type": "integer"
        },
        "candidateId": {
          "minLength": 1,
          "title": "Candidateid",
          "type": "string"
        },
        "investigativePriorityScore": {
          "maximum": 1,
          "minimum": 0,
          "title": "Investigativepriorityscore",
          "type": "number"
        },
        "originProximityScore": {
          "maximum": 1,
          "minimum": 0,
          "title": "Originproximityscore",
          "type": "number"
        },
        "originDwellScore": {
          "maximum": 1,
          "minimum": 0,
          "title": "Origindwellscore",
          "type": "number"
        },
        "releaseTimeAlignmentScore": {
          "maximum": 1,
          "minimum": 0,
          "title": "Releasetimealignmentscore",
          "type": "number"
        },
        "corridorAlignmentScore": {
          "maximum": 1,
          "minimum": 0,
          "title": "Corridoralignmentscore",
          "type": "number"
        },
        "behaviourRuleScore": {
          "maximum": 1,
          "minimum": 0,
          "title": "Behaviourrulescore",
          "type": "number"
        },
        "lstmContinuousScore": {
          "maximum": 1,
          "minimum": 0,
          "title": "Lstmcontinuousscore",
          "type": "number"
        },
        "darkGapScore": {
          "maximum": 1,
          "minimum": 0,
          "title": "Darkgapscore",
          "type": "number"
        },
        "enteredOrigin50": {
          "title": "Enteredorigin50",
          "type": "boolean"
        },
        "enteredOrigin75": {
          "title": "Enteredorigin75",
          "type": "boolean"
        },
        "enteredOrigin90": {
          "title": "Enteredorigin90",
          "type": "boolean"
        },
        "minimumOriginCenterDistanceM": {
          "minimum": 0,
          "title": "Minimumorigincenterdistancem",
          "type": "number"
        },
        "minimumCorridorDistanceM": {
          "minimum": 0,
          "title": "Minimumcorridordistancem",
          "type": "number"
        },
        "closestOriginMidpointOffsetMin": {
          "minimum": 0,
          "title": "Closestoriginmidpointoffsetmin",
          "type": "number"
        },
        "scoreSemantics": {
          "const": "INVESTIGATIVE_PRIORITY_NOT_RESPONSIBILITY_PROBABILITY",
          "title": "Scoresemantics",
          "type": "string"
        },
        "calibrationStatus": {
          "minLength": 1,
          "title": "Calibrationstatus",
          "type": "string"
        },
        "rankLabel": {
          "pattern": "^CAND-[0-9]{3,}$",
          "title": "Ranklabel",
          "type": "string"
        },
        "investigativeScore": {
          "maximum": 100,
          "minimum": 0,
          "title": "Investigativescore",
          "type": "number"
        },
        "scoreBreakdownPoints": {
          "$ref": "#/$defs/ScoreBreakdownPointsPublic"
        },
        "closestApproach": {
          "$ref": "#/$defs/ClosestApproachPublic"
        },
        "candidateTrackRef": {
          "$ref": "#/$defs/CandidateTrackRefPublic"
        },
        "dataQuality": {
          "$ref": "#/$defs/DataQualityPublic"
        },
        "supportingEvidence": {
          "items": {
            "type": "string"
          },
          "title": "Supportingevidence",
          "type": "array"
        },
        "negativeEvidence": {
          "items": {
            "type": "string"
          },
          "title": "Negativeevidence",
          "type": "array"
        },
        "warnings": {
          "items": {
            "type": "string"
          },
          "title": "Warnings",
          "type": "array"
        },
        "legalDisclaimer": {
          "const": "Candidate ranking supports investigation and does not constitute legal attribution or proof of responsibility.",
          "title": "Legaldisclaimer",
          "type": "string"
        }
      },
      "required": [
        "rank",
        "candidateId",
        "investigativePriorityScore",
        "originProximityScore",
        "originDwellScore",
        "releaseTimeAlignmentScore",
        "corridorAlignmentScore",
        "behaviourRuleScore",
        "lstmContinuousScore",
        "darkGapScore",
        "enteredOrigin50",
        "enteredOrigin75",
        "enteredOrigin90",
        "minimumOriginCenterDistanceM",
        "minimumCorridorDistanceM",
        "closestOriginMidpointOffsetMin",
        "scoreSemantics",
        "calibrationStatus",
        "rankLabel",
        "investigativeScore",
        "scoreBreakdownPoints",
        "closestApproach",
        "candidateTrackRef",
        "dataQuality",
        "supportingEvidence",
        "negativeEvidence",
        "warnings",
        "legalDisclaimer"
      ],
      "title": "RankedCandidatePublic",
      "type": "object"
    },
    "ScoreBreakdownPointsPublic": {
      "additionalProperties": false,
      "description": "Weighted score-v1 contributions expressed on a 0-100 scale.",
      "properties": {
        "originProximity": {
          "maximum": 100,
          "minimum": 0,
          "title": "Originproximity",
          "type": "number"
        },
        "originDwell": {
          "maximum": 100,
          "minimum": 0,
          "title": "Origindwell",
          "type": "number"
        },
        "releaseTimeAlignment": {
          "maximum": 100,
          "minimum": 0,
          "title": "Releasetimealignment",
          "type": "number"
        },
        "corridorAlignment": {
          "maximum": 100,
          "minimum": 0,
          "title": "Corridoralignment",
          "type": "number"
        },
        "behaviourRules": {
          "maximum": 100,
          "minimum": 0,
          "title": "Behaviourrules",
          "type": "number"
        },
        "lstmAnomaly": {
          "maximum": 100,
          "minimum": 0,
          "title": "Lstmanomaly",
          "type": "number"
        },
        "darkGap": {
          "maximum": 100,
          "minimum": 0,
          "title": "Darkgap",
          "type": "number"
        }
      },
      "required": [
        "originProximity",
        "originDwell",
        "releaseTimeAlignment",
        "corridorAlignment",
        "behaviourRules",
        "lstmAnomaly",
        "darkGap"
      ],
      "title": "ScoreBreakdownPointsPublic",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "status": {
      "const": "completed",
      "title": "Status",
      "type": "string"
    },
    "caseId": {
      "minLength": 1,
      "title": "Caseid",
      "type": "string"
    },
    "phase2RunId": {
      "minLength": 1,
      "title": "Phase2Runid",
      "type": "string"
    },
    "modelVersion": {
      "minLength": 1,
      "title": "Modelversion",
      "type": "string"
    },
    "outputDirectory": {
      "minLength": 1,
      "title": "Outputdirectory",
      "type": "string"
    },
    "files": {
      "items": {
        "type": "string"
      },
      "title": "Files",
      "type": "array"
    },
    "artifactSha256": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "Artifactsha256",
      "type": "object"
    },
    "candidateCount": {
      "minimum": 0,
      "title": "Candidatecount",
      "type": "integer"
    },
    "scoredWindows": {
      "minimum": 0,
      "title": "Scoredwindows",
      "type": "integer"
    },
    "scoreSemantics": {
      "const": "INVESTIGATIVE_PRIORITY_NOT_RESPONSIBILITY_PROBABILITY",
      "title": "Scoresemantics",
      "type": "string"
    },
    "calibrationStatus": {
      "minLength": 1,
      "title": "Calibrationstatus",
      "type": "string"
    },
    "topCandidates": {
      "items": {
        "$ref": "#/$defs/RankedCandidatePublic"
      },
      "title": "Topcandidates",
      "type": "array"
    },
    "warnings": {
      "items": {},
      "title": "Warnings",
      "type": "array"
    }
  },
  "required": [
    "status",
    "caseId",
    "phase2RunId",
    "modelVersion",
    "outputDirectory",
    "files",
    "artifactSha256",
    "candidateCount",
    "scoredWindows",
    "scoreSemantics",
    "calibrationStatus",
    "topCandidates",
    "warnings"
  ],
  "title": "Phase3RunPublicResponse",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "phase3-run-response-v1.schema.json"
}
